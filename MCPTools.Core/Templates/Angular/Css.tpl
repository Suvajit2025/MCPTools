.{{Route}} {
  display: grid;
  gap: 1rem;
}

.{{Route}}__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.{{Route}}__table {
  width: 100%;
  border-collapse: collapse;
}

.{{Route}}__table th,
.{{Route}}__table td {
  padding: 0.75rem;
  border-bottom: 1px solid #d0d7de;
  text-align: left;
}

.{{Route}}__error {
  color: #b42318;
}
